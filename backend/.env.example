# Atlas backend configuration.
# Copy to `.env` and fill in. Never commit `.env`.

ENVIRONMENT=local
DEBUG=true

# --- Database -----------------------------------------------------------------
# Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://localhost/atlas

# --- Security -----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
# Set true in production so session cookies are only sent over HTTPS.
COOKIE_SECURE=false

# --- Frontend -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- AI providers -------------------------------------------------------------
# Atlas runs without these; AI features report themselves as unavailable until set.
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible service works instead — OpenRouter, Hack Club AI, a local
# llama.cpp server. Set the base URL and use that service's model names, which are
# usually vendor-qualified. Leave OPENAI_BASE_URL unset to talk to OpenAI itself.
#
#   CHAT_PROVIDER=openai
#   OPENAI_BASE_URL=https://ai.hackclub.com/proxy/v1
#   OPENAI_MODEL=anthropic/claude-opus-5
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Through an OpenAI-compatible proxy, name that service's model instead. Ask for 1536
# dimensions: this model is natively 4096, and pgvector's HNSW index stops at 2000, so a
# wider vector would mean no fast search at all.
#   OPENAI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# --- Storage ------------------------------------------------------------------
# Read the client address from X-Forwarded-For. Off by default: a client can send that
# header itself, so trusting it on a directly-exposed deployment defeats rate limiting.
# Turn on only when a proxy you control sets it.
TRUST_PROXY_HEADERS=false
RATE_LIMITING_ENABLED=true

STORAGE_ROOT=var/storage
MAX_UPLOAD_BYTES=52428800
