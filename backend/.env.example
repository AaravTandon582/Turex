# Atlas backend configuration.
# Copy to `.env` and fill in. Never commit `.env`.

ENVIRONMENT=local
DEBUG=true

# --- Database -----------------------------------------------------------------
# Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://localhost/atlas

# --- Security -----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
# Set true in production so session cookies are only sent over HTTPS.
COOKIE_SECURE=false

# --- Frontend -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- AI providers -------------------------------------------------------------
# Atlas runs without these; AI features report themselves as unavailable until set.
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ------------------------------------------------------------------
STORAGE_ROOT=var/storage
MAX_UPLOAD_BYTES=52428800
